---
// Base shell: two-row masthead (brand + nav, then the issue line), optional
// reading-progress line, three-column footer. Page content goes into the
// default slot.
import { site, type NavKey } from '../config/site'
import { getSiteData } from '../lib/fetcher'
import { formatLongDate, roman } from '../lib/notion/render'
import '../styles/fonts.css'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  active?: NavKey
  /** show the thin reading-progress line under the masthead (post pages) */
  progress?: boolean
  /** path to the OG image; post pages pass their own card */
  ogImage?: string
  /** language of the page's main content (a post's `Lang`) */
  lang?: 'en' | 'vi'
}
const { title, description, active, progress = false, ogImage = '/og/default.png', lang = 'en' } = Astro.props
const now = new Date()
const year = now.getFullYear()

// The site reads like a serial: one volume per year since the first post,
// the issue number is everything published so far, dated by this build.
const { posts } = await getSiteData()
const volume = roman(year - site.copyrightFrom + 1).toUpperCase()
const issue = posts.filter((p) => p.published).length
const issueDate = formatLongDate(now)
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(ogImage, Astro.site)
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="duckthedev" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3ebd9" />
    <script is:inline>
      // apply the theme before first paint to avoid a flash: a saved choice
      // wins, otherwise follow the OS setting
      ;(function () {
        var t =
          localStorage.getItem('dtd-theme') ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dim' : 'light')
        document.documentElement.setAttribute('data-theme', t)
        document
          .querySelector('meta[name="theme-color"]')
          .setAttribute('content', t === 'dim' ? '#181410' : '#f3ebd9')
      })()
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <div class="masthead-row">
          <a class="brand" href="/" aria-label={`${site.name} — home`}>
            <span class="brand-mark">{site.mark}</span>
            <span class="brand-name">{site.name}</span>
            <span class="brand-tag">{site.tagline}</span>
          </a>
          <nav class="primary-nav" aria-label="Primary">
            {
              site.nav.map((item) => (
                <a class:list={['nav-link', { active: item.key === active }]} href={item.href}>
                  {item.label}
                </a>
              ))
            }
            <button class="theme-toggle" aria-label="Switch to dark theme">
              <span class="to-dim">dim</span><span class="to-light">light</span>
            </button>
          </nav>
        </div>
        <div class="masthead-meta">
          <span>Vol. {volume}</span>
          <span class="ornament">§</span>
          <span>No. {issue}</span>
          <span class="ornament">§</span>
          <span>{issueDate}</span>
          <span class="spacer"></span>
          <span class="byline">Written by {site.author}, {site.place}</span>
        </div>
      </div>
      {progress && <div class="progress-line" id="progress-line" />}
    </header>

    <slot />

    <footer class="colophon">
      <div class="wrap">
        <div class="colophon-grid">
          <div class="col-block">
            <h4>Read</h4>
            <ul>
              <li><a href="/series">Series</a></li>
              <li><a href="/blog">All writing</a></li>
              <li><a href="/topics">Topics</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
          <div class="col-block">
            <h4>Elsewhere</h4>
            <ul>
              <li><a href="/about">About / CV</a></li>
              <li><a href={site.social.github}>GitHub</a></li>
              <li><a href={site.social.linkedin}>LinkedIn</a></li>
              <li><a href={site.social.email}>Email</a></li>
            </ul>
          </div>
          <div class="col-block">
            <h4>Errata</h4>
            <p>Found a mistake? <a href={site.social.email}>Send a correction.</a> {site.footerNote}</p>
          </div>
        </div>
        <div class="colophon-foot">
          <span>{site.name} · Vol. {volume} · No. {issue}</span>
          <span class="colophon-mark">— set in {site.place} —</span>
          <span>© {site.copyrightFrom}–{year} {site.author}</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/app.js'
    </script>
  </body>
</html>

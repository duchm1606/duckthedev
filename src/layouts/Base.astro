---
// Base shell ported from mock/*.html: masthead + nav, optional reading
// progress line, colophon footer. Page content goes into the default slot.
import { site, type NavKey } from '../config/site'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  active?: NavKey
  /** show the thin reading-progress line under the masthead (post pages) */
  progress?: boolean
}
const { title, description, active, progress = false } = Astro.props
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,400;1,9..144,500;1,9..144,700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // apply the saved theme before first paint to avoid a light-theme flash
      document.documentElement.setAttribute(
        'data-theme',
        localStorage.getItem('dtd-theme') || 'light',
      )
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <div class="masthead-row">
          <a class="brand" href="/">
            <span class="brand-mark">{site.mark}</span>
            <span class="brand-name">{site.name}</span>
            <span class="brand-tag">{site.tagline}</span>
          </a>
          <nav class="primary-nav">
            {
              site.nav.map((item) => (
                <a class:list={['nav-link', { active: item.key === active }]} href={item.href}>
                  {item.label}
                </a>
              ))
            }
            <button class="theme-toggle" aria-label="Toggle theme"
              ><span data-theme-label>dim</span></button
            >
          </nav>
        </div>
      </div>
      {progress && <div class="progress-line" id="progress-line" />}
    </header>

    <slot />

    <footer class="colophon">
      <div class="wrap">
        <div class="colo-grid">
          <div>
            <div class="colo-brand">{site.name}<span>.</span></div>
            <p class="colo-note">{site.coloNote}</p>
          </div>
          <div class="colo-col">
            <h5>Read</h5>
            <ul>
              <li><a href="/series">Series</a></li>
              <li><a href="/blog">All articles</a></li>
              <li><a href="/topics">Topics</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
          <div class="colo-col">
            <h5>Me</h5>
            <ul>
              <li><a href="/about">About / CV</a></li>
              <li><a href={site.social.github}>GitHub</a></li>
              <li><a href={site.social.linkedin}>LinkedIn</a></li>
              <li><a href={site.social.email}>Email</a></li>
            </ul>
          </div>
          <div class="colo-col">
            <h5>Colophon</h5>
            <ul>
              {site.colophonTech.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
        <div class="colo-foot">
          <span>© {site.copyrightFrom}—{year} {site.author}</span>
          <span>{site.coloFoot}</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/app.js'
    </script>
  </body>
</html>

---
// Base shell: masthead + nav, optional reading-progress line, one-row footer.
// Page content goes into the default slot.
import { site, type NavKey } from '../config/site'
import '../styles/fonts.css'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  active?: NavKey
  /** show the thin reading-progress line under the masthead (post pages) */
  progress?: boolean
  /** path to the OG image; post pages pass their own card */
  ogImage?: string
}
const { title, description, active, progress = false, ogImage = '/og/default.png' } = Astro.props
const year = new Date().getFullYear()
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(ogImage, Astro.site)
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="duckthedev" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // apply the saved theme before first paint to avoid a light-theme flash
      document.documentElement.setAttribute(
        'data-theme',
        localStorage.getItem('dtd-theme') || 'light',
      )
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <div class="masthead-row">
          <a class="brand" href="/" aria-label={`${site.name} — home`}>
            <span class="brand-mark">{site.mark}</span>
            <span class="brand-name">{site.name}</span>
          </a>
          <nav class="primary-nav" aria-label="Primary">
            {
              site.nav.map((item) => (
                <a class:list={['nav-link', { active: item.key === active }]} href={item.href}>
                  {item.label}
                </a>
              ))
            }
            <button class="theme-toggle" aria-label="Toggle theme"
              ><span data-theme-label>dim</span></button
            >
          </nav>
        </div>
      </div>
      {progress && <div class="progress-line" id="progress-line" />}
    </header>

    <slot />

    <footer class="colophon">
      <div class="wrap">
        <div class="colo-row">
          <a class="colo-brand" href="/">{site.name}<span>.</span></a>
          <nav class="colo-links" aria-label="Footer">
            <a href="/series">Series</a>
            <a href="/blog">Blog</a>
            <a href="/topics">Topics</a>
            <a href="/about">About</a>
            <a href="/rss.xml">RSS</a>
            <a href={site.social.github}>GitHub</a>
            <a href={site.social.email}>Email</a>
          </nav>
        </div>
        <p class="colo-note">© {site.copyrightFrom}–{year} {site.author} · {site.footerNote}</p>
      </div>
    </footer>

    <script>
      import '../scripts/app.js'
    </script>
  </body>
</html>

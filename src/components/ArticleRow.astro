---
// One row in an article list (blog archive, home "Latest articles").
// data-tags feeds the client-side filter buttons in app.js.
import { formatDate } from '../lib/notion/render'
import type { Post } from '../lib/types'

interface Props {
  post: Post
  minutes?: number
  /** values for the data-tags filter attribute; defaults to the post type */
  tags?: string[]
}
const { post, minutes, tags } = Astro.props
---

<article class="article-row" data-tags={(tags ?? [post.type]).join(' ')}>
  <div class="art-date">{formatDate(post.date)}</div>
  <div>
    <h3 class="art-title">
      <a href={post.url}>{post.title}</a>
      {post.type === 'note' && <span class="badge-pin badge-new">note</span>}
      {post.pinned && <span class="badge-pin">pinned</span>}
      {!post.published && <span class="badge-pin">draft</span>}
    </h3>
    <p class="art-desc">{post.description}</p>
  </div>
  <div class="art-side">
    <div class="tag-chips">
      {post.topics.slice(0, 2).map((t) => <a class="chip" href={`/topics/${t.slug}`}>{t.name}</a>)}
    </div>
    {minutes !== undefined && <div class="art-read">{minutes} min read</div>}
  </div>
</article>

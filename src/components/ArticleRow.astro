---
// One row in a post list: title with the topic tucked under it, one-line
// description, and the date alone on the right. Notes hang a § in the margin.
import { formatDate } from '../lib/notion/render'
import type { Post } from '../lib/types'

interface Props {
  post: Post
}
const { post } = Astro.props
const topic = post.topics[0]
---

<article class="row">
  <div>
    <h3 class="row-title">
      {post.type === 'note' && <span class="note-mark">§</span>}<a href={post.url}>{post.title}</a>
    </h3>
    {topic && <a class="row-topic" href={`/topics/${topic.slug}`}>{topic.name}</a>}
    {post.description && <p class="row-desc">{post.description}</p>}
  </div>
  <div class="row-side">
    {!post.published && <span>Draft · </span>}<time datetime={post.date}>{formatDate(post.date)}</time>
  </div>
</article>

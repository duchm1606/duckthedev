---
// One series row (series index and home). Progress and cadence share one
// short line — no badge, no level, no topic chips.
import type { Series } from '../lib/types'

interface Props {
  series: Series
}
const { series: s } = Astro.props

const progress =
  s.state === 'complete'
    ? `${s.chapterCount} chapters · complete`
    : s.state === 'planned' && s.chapterCount === 0
      ? `${s.plannedChapters ?? '?'} chapters planned`
      : s.publishedCount > 0
        ? `${s.publishedCount} of ${s.chapterCount} out`
        : `${s.chapterCount} chapters · outline`
---

<article class="row row-2">
  <div>
    <h3 class="row-title"><a href={`/series/${s.slug}`}>{s.name}</a></h3>
    <p class="row-desc">{s.description}</p>
  </div>
  <div class="row-meta">
    <span>{progress}</span>
    {s.state !== 'complete' && s.cadence && <span>{s.cadence}</span>}
  </div>
</article>

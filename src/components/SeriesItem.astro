---
// One series row (series index and home). Progress and cadence share one
// short line — no badge, no level, no topic chips.
import type { Series } from '../lib/types'

interface Props {
  series: Series
}
const { series: s } = Astro.props

// exactly one fact on the right so the column edge stays clean —
// cadence and state live on the series page itself
const total = s.chapterCount || s.plannedChapters || 0
const progress =
  s.publishedCount > 0
    ? s.publishedCount === total
      ? `${total} chapters`
      : `${s.publishedCount} of ${total} out`
    : total > 0
      ? `${total} chapters planned`
      : 'outline'
---

<article class="row row-2">
  <div>
    <h3 class="row-title"><a href={`/series/${s.slug}`}>{s.name}</a></h3>
    <p class="row-desc">{s.description}</p>
  </div>
  <div class="row-meta">
    <span>{progress}</span>
  </div>
</article>

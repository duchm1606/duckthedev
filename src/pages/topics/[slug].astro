---
// One topic shelf: everything filed under the topic, newest first.
import ArticleRow from '../../components/ArticleRow.astro'
import Base from '../../layouts/Base.astro'
import { getSiteData } from '../../lib/fetcher'
import { getManyStats } from '../../lib/stats'
import type { Topic } from '../../lib/types'

export async function getStaticPaths() {
  const { topics } = await getSiteData()
  return topics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }))
}

interface Props {
  topic: Topic
}
const { topic } = Astro.props
const { posts } = await getSiteData()

const shelf = posts
  .filter((p) => p.published && p.topics.some((t) => t.slug === topic.slug))
  .sort((a, b) => b.date.localeCompare(a.date))
const articles = shelf.filter((p) => p.type === 'article').length
const notes = shelf.length - articles
const stats = await getManyStats(shelf.map((p) => p.id))
---

<Base title={`${topic.name} — duckthedev`} description={topic.description ?? `Everything filed under ${topic.name}.`} active="topics">
  <section class="wrap">
    <div class="page-head">
      <p class="kicker"><a href="/topics">Topics</a> · {topic.name}</p>
      <h1 class="page-title">{topic.name}</h1>
      {topic.description && <p class="page-deck">{topic.description}</p>}
      <p class="meta">
        <span>{articles} {articles === 1 ? 'article' : 'articles'}</span>
        <span>{notes} {notes === 1 ? 'note' : 'notes'}</span>
      </p>
    </div>
  </section>

  <section class="section wrap">
    {
      shelf.length > 0 ? (
        <div class="list">
          {shelf.map((p) => (
            <ArticleRow post={p} minutes={stats.get(p.id)?.minutes} />
          ))}
        </div>
      ) : (
        <p class="page-deck">Nothing filed here yet.</p>
      )
    }
  </section>
</Base>

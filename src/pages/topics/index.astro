---
// Topic index — one list: pinned topics first (bold), then the rest A–Z.
import Base from '../../layouts/Base.astro'
import { getSiteData } from '../../lib/fetcher'
import type { Topic } from '../../lib/types'

const { topics } = await getSiteData()
const entries = (t: Topic) => t.articleCount + t.noteCount
const pinned = topics.filter((t) => t.pinned)
const rest = [...topics.filter((t) => !t.pinned)].sort((a, b) => a.name.localeCompare(b.name))
const ordered = [...pinned, ...rest]
---

<Base title="Topics — duckthedev" description="Every article and note, filed by topic." active="topics">
  <section class="wrap">
    <div class="page-head">
      <p class="kicker">Index</p>
      <h1 class="page-title">{topics.length} shelves,<br /><em>one notebook.</em></h1>
      <p class="page-deck">Everything, filed by topic. Bold ones are the main shelves.</p>
    </div>
  </section>

  <section class="section wrap">
    <div class="topic-list">
      {
        ordered.map((t) => (
          <a class:list={['topic-row', { pinned: t.pinned, empty: entries(t) === 0 }]} href={`/topics/${t.slug}`}>
            <span>{t.name}</span>
            <span class="count">{entries(t)}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

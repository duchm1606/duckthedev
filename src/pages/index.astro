---
// Home: a two-column hero (intro + desk log of what just came out and what is
// due next), then the series library, featured picks and recent writing.
import ArticleRow from '../components/ArticleRow.astro'
import SeriesItem from '../components/SeriesItem.astro'
import Base from '../layouts/Base.astro'
import { site } from '../config/site'
import { getSiteData } from '../lib/fetcher'
import { approxHours, formatDayMonth, roman, shortSeriesName, upcomingDate } from '../lib/notion/render'
import { getManyStats } from '../lib/stats'
import type { Post } from '../lib/types'

const { posts, series, site: kv } = await getSiteData()
const byDateDesc = (a: Post, b: Post) => b.date.localeCompare(a.date)

const published = posts.filter((p) => p.published).sort(byDateDesc)
const standalone = posts.filter((p) => p.published && !p.series)

// featured: pinned posts, newest first
const featured = [...standalone]
  .filter((p) => p.pinned)
  .sort(byDateDesc)
  .slice(0, 4)
const featuredIds = new Set(featured.map((p) => p.id))

// recent: newest first, minus what the featured list already shows —
// the full archive lives on /blog
const recent = [...standalone]
  .sort(byDateDesc)
  .filter((p) => !featuredIds.has(p.id))
  .slice(0, 6)

const homeSeries = series.slice(0, 3)
const chapterTotal = series.reduce((n, s) => n + s.chapterCount, 0)

// desk log: the three latest entries out, then the next two chapters due —
// the first unwritten ones in series order, even when their date has slipped
// (those read "soon", same as on the series map)
const upcoming = series
  .flatMap((s) => s.parts.flatMap((p) => p.chapters).filter((c) => !c.published).slice(0, 2))
  .sort((a, b) => a.date.localeCompare(b.date))
const deskLog = [...published.slice(0, 3).reverse(), ...upcoming.slice(0, 2)]
const nextDue = upcoming[0]

// hero facts
const stats = await getManyStats(published.map((p) => p.id))
const totalMinutes = [...stats.values()].reduce((n, s) => n + s.minutes, 0)
const latest = published[0]

// "Now writing / Oct — Dec 2026" in the hero's corner
const now = new Date()
const later = new Date(now.getFullYear(), now.getMonth() + 2, 1)
const mon = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short' })
const writingWindow = `${mon(now)} — ${mon(later)} ${later.getFullYear()}`

// sections are numbered in reading order, whichever of them render
let n = 0
const no = () => `${roman(++n).toUpperCase()}.`
---

<Base title={`${site.name} — ${site.tagline}`} description={site.description} active="home">
  <section class="hero">
    <div class="hero-deco">Now writing<br />{writingWindow}</div>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-main">
          <div class="hero-eyebrow">
            <span class="hero-label">{site.hero.kicker}</span>
            <span class="hero-marker">{published.length} entries · since {site.copyrightFrom}</span>
          </div>
          <h1 class="hero-title" set:html={site.hero.title} />
          <p class="hero-deck" set:html={site.hero.deck} />

          <div class="hero-meta">
            <div class="meta-cell">
              <span class="meta-label">Written</span>
              <span class="meta-value">{standalone.length} essays & notes</span>
              <span class="meta-sub">plus {published.length - standalone.length} chapters</span>
            </div>
            {
              nextDue ? (
                <div class="meta-cell">
                  <span class="meta-label">Next chapter</span>
                  <span class="meta-value">due {upcomingDate(nextDue.date)}</span>
                  <span class="meta-sub">Ch. {nextDue.order} · {shortSeriesName(nextDue.series!.name)}</span>
                </div>
              ) : (
                <div class="meta-cell">
                  <span class="meta-label">Series</span>
                  <span class="meta-value">{series.length} running</span>
                  <span class="meta-sub">{chapterTotal} chapters planned</span>
                </div>
              )
            }
            <div class="meta-cell">
              <span class="meta-label">Reading</span>
              <span class="meta-value">{approxHours(totalMinutes)}</span>
              <span class="meta-sub">to read it all</span>
            </div>
          </div>

          <div class="hero-actions">
            {
              latest && (
                <a class="btn-primary" href={latest.url}>
                  Read the latest <span class="arrow">→</span>
                </a>
              )
            }
            <a class="btn-ghost" href="/about">About me / CV</a>
          </div>
        </div>

        <aside class="hero-aside" aria-label="Desk log">
          <div class="aside-head">
            <span>Desk log</span>
            <em>out lately & due next</em>
          </div>
          <ul>
            {
              deskLog.map((p) => {
                const body = (
                  <>
                    <span class="aside-date">{p.published ? formatDayMonth(p.date) : upcomingDate(p.date)}</span>
                    <span class="aside-title">
                      {p.series ? `Ch. ${p.order} · ${p.title}` : p.title}{' '}
                      <em>({p.series ? shortSeriesName(p.series.name) : p.type === 'note' ? 'note' : 'essay'})</em>
                    </span>
                    <span class:list={['aside-tag', { out: p.published }]}>{p.published ? 'out' : 'scheduled'}</span>
                  </>
                )
                return <li>{p.published ? <a class="aside-row" href={p.url}>{body}</a> : <div class="aside-row">{body}</div>}</li>
              })
            }
          </ul>
          {kv.availability && <div class="aside-foot">{kv.availability}</div>}
        </aside>
      </div>
    </div>
  </section>

  {
    homeSeries.length > 0 && (
      <section class="library wrap">
        <div class="section-head">
          <div>
            <div class="section-eyebrow">{no()} Series</div>
            <h2 class="section-title">Subjects too big <em>for one post.</em></h2>
            <p class="section-deck">{series.length} series, {chapterTotal} chapters. One subject, taken in order.</p>
          </div>
        </div>
        <div class="library-list">
          {homeSeries.map((s, i) => <SeriesItem series={s} index={i + 1} />)}
        </div>
        <div class="lib-foot">
          <span>Showing {homeSeries.length} of {series.length} series.</span>
          <a class="text-link" href="/series">Browse the full library →</a>
        </div>
      </section>
    )
  }

  {
    featured.length > 0 && (
      <section class="library wrap">
        <div class="section-head">
          <div>
            <div class="section-eyebrow">{no()} Featured</div>
            <h2 class="section-title">Featured, <em>hand-picked.</em></h2>
          </div>
        </div>
        <div class="library-list">
          {featured.map((p, i) => <ArticleRow post={p} index={i + 1} />)}
        </div>
      </section>
    )
  }

  <section class="library wrap">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">{no()} Recent</div>
        <h2 class="section-title">Recent, <em>newest first.</em></h2>
      </div>
    </div>
    <div class="library-list">
      {recent.map((p, i) => <ArticleRow post={p} index={i + 1} />)}
    </div>
    <div class="lib-foot">
      <span>Showing {recent.length} of {standalone.length} essays and notes.</span>
      <a class="text-link" href="/blog">The full archive →</a>
    </div>
  </section>
</Base>

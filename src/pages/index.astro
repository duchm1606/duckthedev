---
// Home: a short hero, the latest writing with a topic row, and the series.
import ArticleRow from '../components/ArticleRow.astro'
import SeriesItem from '../components/SeriesItem.astro'
import Base from '../layouts/Base.astro'
import { site } from '../config/site'
import { getSiteData } from '../lib/fetcher'
import { getManyStats } from '../lib/stats'

const { posts, series, topics } = await getSiteData()

// standalone writing, pinned first, then newest first
const standalone = posts.filter((p) => p.published && !p.series)
const latest = [...standalone]
  .sort((a, b) => Number(b.pinned) - Number(a.pinned) || b.date.localeCompare(a.date))
  .slice(0, 8)
const stats = await getManyStats(latest.map((p) => p.id))

const topTopics = [...topics]
  .filter((t) => t.articleCount + t.noteCount > 0)
  .sort((a, b) => b.articleCount + b.noteCount - (a.articleCount + a.noteCount))
  .slice(0, 6)

const homeSeries = series.slice(0, 3)
---

<Base title={`duckthedev — ${site.tagline}`} description={site.description} active="home">
  <section class="hero wrap">
    <div class="page-head">
      <p class="kicker">{site.hero.kicker}</p>
      <h1 class="page-title" set:html={site.hero.title} />
      <p class="page-deck" set:html={site.hero.deck} />
      <a class="btn" href="/about">About me →</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Writing</h2>
      <a class="section-link" href="/blog">Archive →</a>
    </div>
    <nav class="chips" aria-label="Topics">
      {
        topTopics.map((t) => (
          <a class="chip" href={`/topics/${t.slug}`}>
            {t.name}<span class="count">{t.articleCount + t.noteCount}</span>
          </a>
        ))
      }
      <a class="chip" href="/topics">All topics →</a>
    </nav>
    <div class="list">
      {latest.map((p) => <ArticleRow post={p} minutes={stats.get(p.id)?.minutes} />)}
    </div>
  </section>

  {
    homeSeries.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2 class="section-title">Series</h2>
          <a class="section-link" href="/series">All {series.length} series →</a>
        </div>
        <div class="list">
          {homeSeries.map((s) => <SeriesItem series={s} />)}
        </div>
      </section>
    )
  }
</Base>

---
// Home: a short hero, the latest writing with a topic row, and the series.
import ArticleRow from '../components/ArticleRow.astro'
import SeriesItem from '../components/SeriesItem.astro'
import Base from '../layouts/Base.astro'
import { site } from '../config/site'
import { getSiteData } from '../lib/fetcher'
import { getManyStats } from '../lib/stats'

const { posts, series } = await getSiteData()

const standalone = posts.filter((p) => p.published && !p.series)

// featured: pinned posts, newest first
const featured = [...standalone]
  .filter((p) => p.pinned)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 4)
const featuredIds = new Set(featured.map((p) => p.id))

// recent: newest first, minus what the featured list already shows —
// the full archive lives on /blog
const recent = [...standalone]
  .sort((a, b) => b.date.localeCompare(a.date))
  .filter((p) => !featuredIds.has(p.id))
  .slice(0, 6)
const stats = await getManyStats([...featured, ...recent].map((p) => p.id))

const homeSeries = series.slice(0, 3)
---

<Base title={`duckthedev — ${site.tagline}`} description={site.description} active="home">
  <section class="hero wrap">
    <div class="page-head">
      <p class="kicker">{site.hero.kicker}</p>
      <h1 class="page-title" set:html={site.hero.title} />
      <p class="page-deck" set:html={site.hero.deck} />
      <a class="btn" href="/about">About me →</a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2 class="section-title">Featured</h2>
        </div>
        <div class="list">
          {featured.map((p) => <ArticleRow post={p} minutes={stats.get(p.id)?.minutes} />)}
        </div>
      </section>
    )
  }

  <section class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Recent</h2>
      <a class="section-link" href="/blog">All articles →</a>
    </div>
    <div class="list">
      {recent.map((p) => <ArticleRow post={p} minutes={stats.get(p.id)?.minutes} />)}
    </div>
  </section>

  {
    homeSeries.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2 class="section-title">Series</h2>
          <a class="section-link" href="/series">All {series.length} series →</a>
        </div>
        <div class="list">
          {homeSeries.map((s) => <SeriesItem series={s} />)}
        </div>
      </section>
    )
  }
</Base>

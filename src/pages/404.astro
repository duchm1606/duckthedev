---
// A missing URL is usually a moved post or a mistyped slug, so this page is a
// way back in rather than an apology: the newest entries. Built statically
// like everything else — hosts serve /404.html for unmatched paths.
import ArticleRow from '../components/ArticleRow.astro'
import Base from '../layouts/Base.astro'
import { getSiteData } from '../lib/fetcher'
import { getManyStats } from '../lib/stats'

const { posts } = await getSiteData()
// `posts` keeps unpublished chapters so the series map can show them as locked
// rows — a "most recent" list must not, in any environment.
const recent = posts.filter((p) => p.published).slice(0, 5)
const stats = await getManyStats(recent.map((p) => p.id))
---

<Base title="Not found — duckthedev" description="That page isn't here. The newest entries are.">
  <section class="wrap">
    <div class="page-head">
      <p class="kicker">404</p>
      <h1 class="page-title">That page <em>isn't here.</em></h1>
      <p class="page-deck">
        The slug changed or never existed. Try the newest entries below, or
        <a class="btn" href="/topics">browse by topic →</a>
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Most recent</h2>
      <a class="section-link" href="/blog">Archive →</a>
    </div>
    <div class="list">
      {recent.map((post) => <ArticleRow post={post} minutes={stats.get(post.id)?.minutes} />)}
    </div>
  </section>
</Base>

---
// Series map ported from mock/series-detail.html: page head with derived
// stats, then Parts → chapter rows (locked rows for unpublished chapters).
import Base from '../../../layouts/Base.astro'
import { getSiteData } from '../../../lib/fetcher'
import {
  approxHours,
  durationLabel,
  formatDayMonth,
  roman,
} from '../../../lib/notion/render'
import { getManyStats } from '../../../lib/stats'
import type { Series } from '../../../lib/types'

export async function getStaticPaths() {
  const { series } = await getSiteData()
  return series.map((s, i) => ({ params: { slug: s.slug }, props: { series: s, number: i + 1 } }))
}

interface Props {
  series: Series
  number: number
}
const { series: s, number } = Astro.props

const chapters = s.parts.flatMap((p) => p.chapters)
const stats = await getManyStats(chapters.filter((c) => c.published).map((c) => c.id))
const minutesOf = (id: string) => stats.get(id)?.minutes ?? 0
const totalMinutes = chapters.reduce((sum, c) => sum + minutesOf(c.id), 0)
const firstPublished = chapters.find((c) => c.published)

const eyebrow = `Series № ${number}${s.cadence ? ` · ${s.cadence}` : s.state === 'complete' ? ' · complete' : ''}`
---

<Base title={`${s.name} — duckthedev`} description={s.description} active="series">
  <div class="wrap">
    <div class="breadcrumb">
      <a href="/">Home</a><span class="sep">/</span>
      <a href="/series">Series</a><span class="sep">/</span>
      <span>{s.name}</span>
    </div>
  </div>

  <section class="wrap">
    <div class="page-head">
      <div class="page-eyebrow">{eyebrow}</div>
      <h1 class="page-title">{s.name}</h1>
      <p class="page-deck">{s.description}</p>
      <div class="ser-tags" style="margin-top:18px;">
        {
          s.topics.map((t, i) => (
            <a class:list={['chip', { solid: i === 0 }]} href={`/topics/${t.slug}`}>{t.name}</a>
          ))
        }
      </div>
      <div class="page-stats">
        <span><strong>{s.chapterCount || s.plannedChapters || 0}</strong> chapters</span>
        {
          s.parts.filter((p) => p.name).length > 0 && (
            <span><strong>{s.parts.filter((p) => p.name).length}</strong> parts</span>
          )
        }
        <span><strong>{s.publishedCount}</strong> published</span>
        {totalMinutes > 0 && <span><strong>{approxHours(totalMinutes)}</strong> total</span>}
        {s.level && <span>Level <strong>{s.level}</strong></span>}
        {s.nextDate && <span>Next out <strong>{formatDayMonth(s.nextDate)}</strong></span>}
      </div>
    </div>
  </section>

  <section class="section" style="border-bottom:none;">
    <div class="wrap">
      <div class="series-map">
        <div>
          {
            s.parts.map((part) => {
              const partMinutes = part.chapters.reduce((sum, c) => sum + minutesOf(c.id), 0)
              const publishing = part.chapters.some((c) => !c.published)
              return (
                <div class="part-block">
                  {part.name && (
                    <div class="part-head">
                      <div>
                        <div class="part-kicker">Part {roman(part.order).toUpperCase()}</div>
                        <div class="part-name">{part.name}</div>
                      </div>
                      <div class="part-meta">
                        {part.chapters.length} chapters
                        {partMinutes > 0 && ` · ${durationLabel(partMinutes)}`}
                        {publishing && ' · publishing'}
                        {part.note && ` · ${part.note}`}
                      </div>
                    </div>
                  )}
                  {part.chapters.map((c) =>
                    c.published ? (
                      <a class="chap-row" href={c.url}>
                        <div class="chap-no">{String(c.order ?? 0).padStart(2, '0')}</div>
                        <div>
                          <div class="chap-title">{c.title}</div>
                          <div class="chap-sub">{c.description}</div>
                        </div>
                        <div class="chap-stat">
                          {minutesOf(c.id)} min · {formatDayMonth(c.date)}
                        </div>
                      </a>
                    ) : (
                      <div class="chap-row locked">
                        <div class="chap-no">{String(c.order ?? 0).padStart(2, '0')}</div>
                        <div>
                          <div class="chap-title">{c.title}</div>
                          <div class="chap-sub">{c.description}</div>
                        </div>
                        <div class="chap-stat">due {formatDayMonth(c.date)}</div>
                      </div>
                    ),
                  )}
                </div>
              )
            })
          }
        </div>
      </div>

      <div class="hero-actions" style="margin-top:8px;">
        {
          firstPublished && (
            <a class="btn-primary" href={firstPublished.url}>
              Start from chapter {firstPublished.order} <span class="arrow">→</span>
            </a>
          )
        }
        <a class="btn-ghost" href="/series">All series</a>
      </div>
    </div>
  </section>
</Base>

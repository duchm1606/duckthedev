---
// Series map: page head with one meta line, then Parts → chapter rows
// (locked rows for unpublished chapters).
import Base from '../../../layouts/Base.astro'
import { getSiteData } from '../../../lib/fetcher'
import { approxHours, formatDayMonth, roman } from '../../../lib/notion/render'
import { getManyStats } from '../../../lib/stats'
import type { Series } from '../../../lib/types'

export async function getStaticPaths() {
  const { series } = await getSiteData()
  return series.map((s) => ({ params: { slug: s.slug }, props: { series: s } }))
}

interface Props {
  series: Series
}
const { series: s } = Astro.props

const chapters = s.parts.flatMap((p) => p.chapters)
const stats = await getManyStats(chapters.filter((c) => c.published).map((c) => c.id))
const minutesOf = (id: string) => stats.get(id)?.minutes ?? 0
const totalMinutes = chapters.reduce((sum, c) => sum + minutesOf(c.id), 0)
const firstPublished = chapters.find((c) => c.published)
const namedParts = s.parts.filter((p) => p.name).length
const pad = (n?: number) => String(n ?? 0).padStart(2, '0')

const state = s.state === 'complete' ? 'Complete' : (s.cadence ?? (s.state === 'planned' ? 'Planned' : 'Ongoing'))
---

<Base title={`${s.name} — duckthedev`} description={s.description} active="series">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">
        <span>{state}</span>
        {s.topics.slice(0, 3).map((t) => <> · <a href={`/topics/${t.slug}`}>{t.name}</a></>)}
      </p>
      <h1 class="page-title">{s.name}</h1>
      <p class="page-deck">{s.description}</p>
      <p class="meta">
        <span>{s.chapterCount || s.plannedChapters || 0} chapters</span>
        {namedParts > 0 && <span>{namedParts} parts</span>}
        <span>{s.publishedCount} published</span>
        {totalMinutes > 0 && <span>{approxHours(totalMinutes)} of reading</span>}
        {s.nextDate && <span>next {formatDayMonth(s.nextDate)}</span>}
      </p>
    </header>

    <section class="narrow">
      {
        s.parts.map((part) => (
          <div class="part">
            {part.name && (
              <h2 class="part-title">
                <span class="n">{roman(part.order).toUpperCase()}.</span>{part.name}
              </h2>
            )}
            {part.chapters.map((c) =>
              c.published ? (
                <a class="chap" href={c.url}>
                  <span class="chap-no">{pad(c.order)}</span>
                  <span>
                    <span class="chap-title">{c.title}</span>
                    {c.description && <span class="chap-desc" style="display:block">{c.description}</span>}
                  </span>
                  <span class="chap-meta">{minutesOf(c.id)} min · {formatDayMonth(c.date)}</span>
                </a>
              ) : (
                <div class="chap locked">
                  <span class="chap-no">{pad(c.order)}</span>
                  <span>
                    <span class="chap-title">{c.title}</span>
                    {c.description && <span class="chap-desc" style="display:block">{c.description}</span>}
                  </span>
                  <span class="chap-meta">due {formatDayMonth(c.date)}</span>
                </div>
              ),
            )}
          </div>
        ))
      }

      {
        firstPublished && (
          <p style="margin-top:28px;">
            <a class="btn" href={firstPublished.url}>Start from chapter {firstPublished.order} →</a>
          </p>
        )
      }
    </section>
  </div>
</Base>

---
// Chapter reader — a full-width chapter head, then three columns: the
// series outline (sticky, left), the chapter, and this page's TOC (sticky,
// right). Below 1200px the TOC folds into a <details> above the body; on
// narrow screens the outline does too. A "next up" band closes the page.
import Block from '../../../components/blocks/Block.astro'
import SeriesOutline from '../../../components/SeriesOutline.astro'
import Base from '../../../layouts/Base.astro'
import { site } from '../../../config/site'
import { getSiteData } from '../../../lib/fetcher'
import { getBlocks } from '../../../lib/notion/client'
import {
  annotateHeadings,
  dropDuplicateLede,
  extractHeadings,
  formatDate,
  groupLists,
  roman,
  upcomingDate,
} from '../../../lib/notion/render'
import { getPostStats } from '../../../lib/stats'
import { isProd } from '../../../lib/env'
import type { Post, Series } from '../../../lib/types'

export async function getStaticPaths() {
  const { series } = await getSiteData()
  return series.flatMap((s) =>
    s.parts
      .flatMap((p) => p.chapters)
      // draft chapters get preview pages in dev but stay locked in prod
      .filter((c) => c.published || !isProd())
      .map((c) => ({
        params: { slug: s.slug, chapter: `${String(c.order ?? 0).padStart(2, '0')}-${c.slug}` },
        props: { series: s, post: c },
      })),
  )
}

interface Props {
  series: Series
  post: Post
}
const { series: s, post } = Astro.props

const blocks = await getBlocks(post.id)
annotateHeadings(blocks)
const grouped = groupLists(blocks)
const headings = extractHeadings(blocks)
const { words, minutes } = await getPostStats(post.id)
// the page head already shows the Description as the deck
dropDuplicateLede(grouped, post.description)

const chapters = s.parts.flatMap((p) => p.chapters)
const idx = chapters.findIndex((c) => c.id === post.id)
const prev = idx > 0 ? chapters[idx - 1] : undefined
const next = idx < chapters.length - 1 ? chapters[idx + 1] : undefined
const currentPartOrder = post.part?.order ?? 99
const reachable = (c?: Post) => !!c && (c.published || !isProd())
const nextMinutes = next?.published ? (await getPostStats(next.id)).minutes : 0
---

<Base
  title={`Ch. ${post.order} · ${post.title} — ${s.name} — duckthedev`}
  description={post.description}
  active="series"
  progress
  ogImage={`/og/${post.slug}.png`}
  lang={post.lang}
>
  <article class="wrap">
    <header class="page-head">
      <div class="eyebrow">
        <a href={`/series/${s.slug}`}>{s.name}</a>
        {post.part && <><span class="dot">·</span><span class="quiet">Part {roman(post.part.order).toUpperCase()}</span></>}
        <span class="dot">·</span><span class="quiet">Chapter {post.order} of {s.chapterCount}</span>
        <span class="dot">·</span><span class="quiet">{words.toLocaleString('en-US')} words</span>
      </div>
      <h1 class="page-title">{post.title}</h1>
      {post.description && <p class="page-deck">{post.description}</p>}
      <p class="page-byline">
        By <em>{site.author}</em> · {post.published ? 'published' : 'draft, due'} {formatDate(post.date)} · {minutes} min read
      </p>
    </header>

    <div class:list={['reader-layout', { 'reader-wide': headings.length > 0 }]}>
      <aside class="reader-aside" aria-label="Series outline">
        <div class="toc-section outline">
          <div class="toc-label">In this series</div>
          <SeriesOutline series={s} currentId={post.id} currentPartOrder={currentPartOrder} />
        </div>
      </aside>

      <div class="reader-main">
        <details class="outline-sheet">
          <summary>{s.name} · ch. {post.order} of {s.chapterCount}</summary>
          <SeriesOutline series={s} currentId={post.id} currentPartOrder={currentPartOrder} />
        </details>
        {
          headings.length > 0 && (
            <details class="toc-inline">
              <summary>On this page</summary>
              <nav class="toc">
                {headings.map((h) => (
                  <a href={`#${h.id}`} class:list={[{ sub: h.level === 3 }]}>{h.text}</a>
                ))}
              </nav>
            </details>
          )
        }

        <div class="post-body">
          {grouped.map((block) => <Block block={block} />)}
        </div>

        <p class="post-foot">
          {post.topics.length > 0 && <>Filed under {post.topics.map((t, i) => <>{i > 0 && ', '}<a href={`/topics/${t.slug}`}>{t.name}</a></>)} · </>}
          {post.published ? 'Published' : 'Draft, due'} {formatDate(post.date)}.
        </p>

        {
          reachable(prev) && (
            <nav class="post-nav" aria-label="Previous chapter">
              <a href={prev!.url}>
                <span class="dir">← Chapter {prev!.order}</span>
                <span class="t">{prev!.title}</span>
              </a>
            </nav>
          )
        }
      </div>

      {
        headings.length > 0 && (
          <aside class="reader-aside reader-toc" aria-label="On this page">
            <div class="toc-section">
              <div class="toc-label">On this page</div>
              <nav class="toc">
                {headings.map((h) => (
                  <a href={`#${h.id}`} class:list={[{ sub: h.level === 3 }]}>{h.text}</a>
                ))}
              </nav>
            </div>
          </aside>
        )
      }
    </div>
  </article>

  <section class="next-up">
    <div class="wrap">
      {
        next ? (
          <div class="next-up-grid">
            <div>
              <div class="next-up-label">Next in this series · Chapter {next.order} of {s.chapterCount}</div>
              <h2 class="next-up-title">{reachable(next) ? <a href={next.url}>{next.title}</a> : next.title}</h2>
              <div class="next-up-meta">
                {next.published
                  ? `Published ${formatDate(next.date)} · ${nextMinutes} min read`
                  : `Due ${upcomingDate(next.date)} · ${s.name}`}
              </div>
            </div>
            {reachable(next) ? (
              <a class="next-up-cta text-link" href={next.url}>continue reading →</a>
            ) : (
              <a class="next-up-cta text-link" href="/rss.xml">follow via RSS →</a>
            )}
          </div>
        ) : (
          <div class="next-up-grid">
            <div>
              <div class="next-up-label">End of the series</div>
              <h2 class="next-up-title">{s.name}</h2>
              <div class="next-up-meta">{s.chapterCount} chapters · {s.publishedCount} out</div>
            </div>
            <a class="next-up-cta text-link" href={`/series/${s.slug}`}>back to the series map →</a>
          </div>
        )
      }
    </div>
  </section>
</Base>

---
// Chapter reader — three columns on wide screens (series outline · chapter ·
// page TOC); the outline and TOC collapse into <details> above the chapter
// on narrow ones.
import Block from '../../../components/blocks/Block.astro'
import SeriesOutline from '../../../components/SeriesOutline.astro'
import Base from '../../../layouts/Base.astro'
import { getSiteData } from '../../../lib/fetcher'
import { getBlocks } from '../../../lib/notion/client'
import {
  annotateHeadings,
  extractHeadings,
  formatDate,
  groupLists,
  roman,
} from '../../../lib/notion/render'
import { getPostStats } from '../../../lib/stats'
import { isProd } from '../../../lib/env'
import type { Post, Series } from '../../../lib/types'

export async function getStaticPaths() {
  const { series } = await getSiteData()
  return series.flatMap((s) =>
    s.parts
      .flatMap((p) => p.chapters)
      // draft chapters get preview pages in dev but stay locked in prod
      .filter((c) => c.published || !isProd())
      .map((c) => ({
        params: { slug: s.slug, chapter: `${String(c.order ?? 0).padStart(2, '0')}-${c.slug}` },
        props: { series: s, post: c },
      })),
  )
}

interface Props {
  series: Series
  post: Post
}
const { series: s, post } = Astro.props

const blocks = await getBlocks(post.id)
annotateHeadings(blocks)
const grouped = groupLists(blocks)
const headings = extractHeadings(blocks)
const { minutes } = await getPostStats(post.id)
const ledeIndex = grouped.findIndex((b) => b.type === 'paragraph')

const chapters = s.parts.flatMap((p) => p.chapters)
const idx = chapters.findIndex((c) => c.id === post.id)
const prev = idx > 0 ? chapters[idx - 1] : undefined
const next = idx < chapters.length - 1 ? chapters[idx + 1] : undefined
const currentPartOrder = post.part?.order ?? 99
const reachable = (c?: Post) => !!c && (c.published || !isProd())
---

<Base
  title={`Ch. ${post.order} · ${post.title} — ${s.name} — duckthedev`}
  description={post.description}
  active="series"
  progress
  ogImage={`/og/${post.slug}.png`}
>
  <div class="wrap reader">
    <aside class="outline" aria-label="Series outline">
      <SeriesOutline series={s} currentId={post.id} currentPartOrder={currentPartOrder} />
    </aside>

    <article class="post-main">
      <details class="outline-sheet">
        <summary>{s.name} · ch. {post.order} of {s.chapterCount}</summary>
        <SeriesOutline series={s} currentId={post.id} currentPartOrder={currentPartOrder} />
      </details>

      <header class="page-head">
        <p class="kicker">
          {post.part && <span>Part {roman(post.part.order).toUpperCase()} · </span>}
          <span>Chapter {post.order} of {s.chapterCount} · {minutes} min</span>
        </p>
        <h1 class="page-title">{post.title}</h1>
        {post.description && <p class="page-deck">{post.description}</p>}
      </header>

      {
        headings.length > 0 && (
          <details class="toc-inline">
            <summary>On this page</summary>
            <nav class="toc">
              {headings.map((h) => (
                <a href={`#${h.id}`} class:list={[{ sub: h.level === 3 }]}>{h.text}</a>
              ))}
            </nav>
          </details>
        )
      }

      <div class="post-body">
        {grouped.map((block, i) => <Block block={block} lede={i === ledeIndex} />)}
      </div>

      <p class="meta post-foot">
        <span>{post.published ? 'Published' : 'Draft'} {formatDate(post.date)}</span>
        {post.topics.map((t) => <a href={`/topics/${t.slug}`}>{t.name}</a>)}
      </p>

      {
        (reachable(prev) || reachable(next)) && (
          <nav class="post-nav" aria-label="Previous and next chapter">
            {reachable(prev) && (
              <a href={prev!.url}>
                <span class="dir">← Ch. {prev!.order}</span>
                <span class="t">{prev!.title}</span>
              </a>
            )}
            {reachable(next) && (
              <a href={next!.url}>
                <span class="dir">Ch. {next!.order} →</span>
                <span class="t">{next!.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      headings.length > 0 && (
        <aside class="post-aside">
          <div class="toc-title">On this page</div>
          <nav class="toc">
            {headings.map((h) => (
              <a href={`#${h.id}`} class:list={[{ sub: h.level === 3 }]}>{h.text}</a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</Base>

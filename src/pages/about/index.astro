---
// About / CV — one column, data from src/config/cv.ts. The Notion `Site`
// database still supplies the two things edited away from the laptop:
// availability and the CV PDF link.
import Base from '../../layouts/Base.astro'
import { cv, type CvItem } from '../../config/cv'
import { site } from '../../config/site'
import { getSiteData } from '../../lib/fetcher'

const { site: kv } = await getSiteData()
// contact address is repo config, not the Notion `Site` KV — the KV still
// carries the seed placeholder and would silently win otherwise
const emailAddr = site.social.email.replace('mailto:', '')

const groups: { title: string; items: CvItem[] }[] = [
  { title: 'Experience', items: cv.experience },
  { title: 'Things I made', items: cv.projects },
  { title: 'Education', items: cv.education },
]
---

<Base title="About me — duckthedev" description={site.about.deck} active="about">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="kicker">{site.about.kicker}</p>
      <h1 class="page-title" set:html={site.about.title} />
      <p class="page-deck">{site.about.deck}</p>
      <dl class="facts">
        {site.about.coords.map(({ k, v }) => <><dt>{k}</dt><dd>{v}</dd></>)}
        <dt>Email</dt><dd><a href={`mailto:${emailAddr}`}>{emailAddr}</a></dd>
        <dt>GitHub</dt><dd><a href={site.social.github}>{site.social.github.replace('https://', '')}</a></dd>
        <dt>LinkedIn</dt><dd><a href={site.social.linkedin}>{site.social.linkedin.replace('https://www.', '')}</a></dd>
        {kv.availability && <><dt>Now</dt><dd>{kv.availability}</dd></>}
        {kv.cv_pdf_url && <><dt>CV</dt><dd><a href={kv.cv_pdf_url}>Download as PDF</a></dd></>}
      </dl>
    </header>

    {
      groups.map(({ title, items }) => (
        <section class="section">
          <div class="section-head"><h2 class="section-title">{title}</h2></div>
          <div class="cv">
            {items.map((e) => (
              <article class="cv-row">
                <div class="cv-date">{e.when}</div>
                <div>
                  <h3 class="cv-role">{e.role}</h3>
                  <p class="cv-where">
                    {e.orgUrl ? <a href={e.orgUrl}>{e.org}</a> : e.org}
                    {e.where && ` · ${e.where}`}
                  </p>
                  {e.blurb && <p class="cv-blurb">{e.blurb}</p>}
                  {e.bullets && e.bullets.length > 0 && (
                    <ul class="cv-bullets">
                      {e.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  )}
                  {e.parts?.map((part) => (
                    <div class="cv-part">
                      <h4 class="cv-part-name">{part.name}</h4>
                      {part.blurb && <p class="cv-blurb">{part.blurb}</p>}
                      <ul class="cv-bullets">
                        {part.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <section class="section">
      <div class="section-head"><h2 class="section-title">Say hello</h2></div>
      <p class="page-deck">{site.about.sayHello}</p>
      <p class="meta" style="margin-top:16px;">
        <a href={`mailto:${emailAddr}`}>{emailAddr}</a>
        <a href={site.social.github}>GitHub</a>
        <a href={site.social.linkedin}>LinkedIn</a>
      </p>
    </section>
  </div>
</Base>

---
// About / CV — a page head with the coordinates as a fact row, then one
// numbered section per CV group. Data from src/config/cv.ts.
import Base from '../../layouts/Base.astro'
import { cv, type CvItem } from '../../config/cv'
import { site } from '../../config/site'
import { roman } from '../../lib/notion/render'

const emailAddr = site.social.email.replace('mailto:', '')

const groups: { title: string; items: CvItem[] }[] = [
  { title: 'Experience', items: cv.experience },
  { title: 'Things I made', items: cv.projects },
  { title: 'Education', items: cv.education },
]
---

<Base title="About me — duckthedev" description={site.about.deck} active="about">
  <div class="wrap">
    <header class="page-head about-head">
      <div class="eyebrow">{site.about.kicker}</div>
      <h1 class="page-title" set:html={site.about.title} />
      <p class="page-deck">{site.about.deck}</p>
      <div class="hero-meta">
        {
          site.about.coords.map(({ k, v }) => (
            <div class="meta-cell">
              <span class="meta-label">{k}</span>
              <span class="meta-value">{v}</span>
            </div>
          ))
        }
        <div class="meta-cell">
          <span class="meta-label">Elsewhere</span>
          <span class="meta-value">
            <a href={site.social.github}>GitHub</a> · <a href={site.social.linkedin}>LinkedIn</a>
          </span>
          <span class="meta-sub"><a href={`mailto:${emailAddr}`}>{emailAddr}</a></span>
        </div>
      </div>
    </header>

    {
      groups.map(({ title, items }, i) => (
        <section>
          <div class="section-head">
            <div>
              <div class="section-eyebrow">{roman(i + 1).toUpperCase()}.</div>
              <h2 class="section-title">{title}</h2>
            </div>
          </div>
          <div class="cv">
            {items.map((e) => (
              <article class="cv-row">
                <div class="cv-date">{e.when}</div>
                <div>
                  <h3 class="cv-role">{e.role}</h3>
                  <p class="cv-where">
                    {e.orgUrl ? <a href={e.orgUrl}>{e.org}</a> : e.org}
                    {e.where && ` · ${e.where}`}
                  </p>
                  {e.blurb && <p class="cv-blurb">{e.blurb}</p>}
                  {e.bullets && e.bullets.length > 0 && (
                    <ul class="cv-bullets">
                      {e.bullets.map((b) => <li set:html={b} />)}
                    </ul>
                  )}
                  {e.parts?.map((part) => (
                    <div class="cv-part">
                      <h4 class="cv-part-name">{part.name}</h4>
                      {part.blurb && <p class="cv-blurb">{part.blurb}</p>}
                      <ul class="cv-bullets">
                        {part.bullets.map((b) => <li set:html={b} />)}
                      </ul>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <section class="say-hello">
      <div class="section-head">
        <div>
          <div class="section-eyebrow">{roman(groups.length + 1).toUpperCase()}.</div>
          <h2 class="section-title">Say hello</h2>
          <p class="section-deck">{site.about.sayHello}</p>
        </div>
      </div>
      <div class="hero-actions">
        <a class="btn-primary" href={`mailto:${emailAddr}`}>{emailAddr} <span class="arrow">→</span></a>
        <a class="btn-ghost" href={site.social.github}>GitHub</a>
        <a class="btn-ghost" href={site.social.linkedin}>LinkedIn</a>
      </div>
    </section>
  </div>
</Base>

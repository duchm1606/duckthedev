---
// Standalone post page (posts without a Series).
import Block from '../../components/blocks/Block.astro'
import { getSiteData } from '../../lib/fetcher'
import { getBlocks } from '../../lib/notion/client'
import {
  annotateHeadings,
  extractHeadings,
  formatDate,
  groupLists,
  readingMinutes,
  wordCount,
} from '../../lib/notion/render'
import Base from '../../layouts/Base.astro'
import type { Post } from '../../lib/types'

export async function getStaticPaths() {
  const { posts } = await getSiteData()
  // newest-first list of standalone posts; prev = older, next = newer
  const standalone = posts.filter((p) => !p.series)
  return standalone.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, older: standalone[i + 1], newer: standalone[i - 1] },
  }))
}

interface Props {
  post: Post
  older?: Post
  newer?: Post
}
const { post, older, newer } = Astro.props
const { posts } = await getSiteData()

const blocks = await getBlocks(post.id)
annotateHeadings(blocks)
const grouped = groupLists(blocks)
const headings = extractHeadings(blocks)
const minutes = readingMinutes(wordCount(blocks))
const ledeIndex = grouped.findIndex((b) => b.type === 'paragraph')

// Related: hand-picked via the Related relation, else fall back to shared topics
const byId = new Map(posts.map((p) => [p.id, p]))
const related = (
  post.relatedIds.length
    ? post.relatedIds.map((id) => byId.get(id)).filter((p): p is Post => !!p)
    : posts.filter(
        (p) =>
          p.id !== post.id &&
          p.published &&
          p.topics.some((t) => post.topics.some((x) => x.slug === t.slug)),
      )
).slice(0, 3)

const updated = post.updated && post.updated !== post.date ? post.updated : undefined
---

<Base
  title={`${post.title} — duckthedev`}
  description={post.description}
  active="blog"
  progress
  ogImage={`/og/${post.slug}.png`}
>
  <div class="wrap post">
    <article class="post-main">
      <header class="page-head">
        <p class="kicker">
          <span>{post.type === 'article' ? 'Essay' : 'Note'}</span>
          {post.topics.slice(0, 3).map((t) => <> · <a href={`/topics/${t.slug}`}>{t.name}</a></>)}
        </p>
        <h1 class="page-title">{post.title}</h1>
        {post.description && <p class="page-deck">{post.description}</p>}
        <p class="meta">
          <time datetime={post.date}>{formatDate(post.date)}</time>
          <span>{minutes} min</span>
          {!post.published && <span>Draft</span>}
        </p>
      </header>

      {
        headings.length > 0 && (
          <details class="toc-inline">
            <summary>On this page</summary>
            <nav class="toc">
              {headings.map((h) => (
                <a href={`#${h.id}`} class:list={[{ sub: h.level === 3 }]}>{h.text}</a>
              ))}
            </nav>
          </details>
        )
      }

      <div class="post-body">
        {grouped.map((block, i) => <Block block={block} lede={i === ledeIndex} />)}
      </div>

      {updated && <p class="meta post-foot">Updated {formatDate(updated)}</p>}

      {
        (older || newer) && (
          <nav class="post-nav" aria-label="Previous and next">
            {older && (
              <a href={older.url}>
                <span class="dir">← Previous</span>
                <span class="t">{older.title}</span>
              </a>
            )}
            {newer && (
              <a href={newer.url}>
                <span class="dir">Next →</span>
                <span class="t">{newer.title}</span>
              </a>
            )}
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="related">
            <h2 class="toc-title">Related</h2>
            <ul>
              {related.map((p) => <li><a href={p.url}>{p.title}</a></li>)}
            </ul>
          </section>
        )
      }
    </article>

    {
      headings.length > 0 && (
        <aside class="post-aside">
          <div class="toc-title">On this page</div>
          <nav class="toc">
            {headings.map((h) => (
              <a href={`#${h.id}`} class:list={[{ sub: h.level === 3 }]}>{h.text}</a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</Base>

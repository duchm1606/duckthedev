---
// Blog archive — standalone posts grouped by year, newest first.
import ArticleRow from '../../components/ArticleRow.astro'
import Base from '../../layouts/Base.astro'
import { getSiteData } from '../../lib/fetcher'

const { posts } = await getSiteData()
const standalone = [...posts.filter((p) => !p.series)].sort((a, b) => b.date.localeCompare(a.date))

const byYear = new Map<string, typeof standalone>()
for (const post of standalone) {
  const year = post.date.slice(0, 4)
  byYear.set(year, [...(byYear.get(year) ?? []), post])
}
const years = [...byYear.keys()].sort().reverse()
---

<Base title="Blog — duckthedev" description="Archive of all articles and notes." active="blog">
  <section class="wrap">
    <div class="page-head">
      <p class="kicker">Archive</p>
      <h1 class="page-title">Everything I've<br /><em>published.</em></h1>
      <p class="page-deck">Articles and notes, newest first.</p>
    </div>
  </section>

  {
    years.map((year) => (
      <section class="section wrap">
        <div class="section-head">
          <h2 class="section-title">{year}</h2>
        </div>
        <div class="list">
          {byYear.get(year)!.map((post) => (
            <ArticleRow post={post} />
          ))}
        </div>
      </section>
    ))
  }
</Base>

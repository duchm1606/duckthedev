# ── Notion (bắt buộc) ─────────────────────────────────────────────
# Tạo tại https://www.notion.so/my-integrations → New integration
#   - Type: Internal
#   - Capabilities: chỉ cần Read content (sync là read-only;
#     riêng scripts/seed-notion.mjs mới cần Insert/Update)
# Sau khi tạo, PHẢI connect integration vào page CMS:
#   mở page cha (page_url trong scripts/notion-ids.json)
#   → menu ⋯ → Connections → chọn integration vừa tạo.
# Connect ở page cha là đủ — 7 database con thừa hưởng quyền.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Notion databases (bắt buộc) ───────────────────────────────────
# Cách lấy ID: mở database full-page trong Notion → ⋯ → Copy link →
# database_id là đoạn 32 ký tự hex trong URL (trước dấu ?).
# Hoặc chạy scripts/seed-notion.mjs để dựng workspace mẫu —
# script in sẵn block env này ở cuối.
# (data_source_id cho API 2025-09-03 được code tự resolve lúc build.)
NOTION_DB_POSTS=
NOTION_DB_SERIES=
NOTION_DB_PARTS=
NOTION_DB_TOPICS=
NOTION_DB_CV=
NOTION_DB_SKILLS=
NOTION_DB_SITE=

# ── Site ──────────────────────────────────────────────────────────
# Canonical URL — dùng cho RSS, sitemap, OG image. Astro đọc biến
# PUBLIC_* ở cả client lẫn server; biến không có PUBLIC_ chỉ ở server/build.
PUBLIC_SITE_URL=https://duckthedev.com

# ── Tuỳ chọn ──────────────────────────────────────────────────────
# dev  = render cả draft/review (xem trước bài đang viết)
# prod = chỉ Status = published
ENV_MODE=dev

# Khoảng nghỉ (ms) giữa các request Notion, rate limit thật ~3 req/s.
# Mặc định 340, chỉ chỉnh khi bị 429 liên tục.
# NOTION_THROTTLE_MS=340

# Chỉ cần khi chạy lại scripts/seed-notion.mjs (dựng lại workspace):
# NOTION_PARENT_PAGE_ID=

# ── Notion (required) ─────────────────────────────────────────────
# Create at https://www.notion.so/my-integrations → New integration
#   - Type: Internal
#   - Capabilities: Read content is all the build needs.
# After creating it, you MUST connect the integration to your CMS page:
#   open the parent page → ⋯ menu → Connections → pick your integration.
# Connecting the parent page is enough — child databases inherit access.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Notion databases (required) ───────────────────────────────────
# To find an ID: open the database as a full page in Notion → ⋯ →
# Copy link → the database_id is the 32-hex-char segment in the URL
# (before the ?). The schema of each database is in docs/notion-cms.md.
# (data_source_id for API 2025-09-03 is resolved automatically at build.)
NOTION_DB_POSTS=
NOTION_DB_SERIES=
NOTION_DB_PARTS=
NOTION_DB_TOPICS=
NOTION_DB_SITE=

# ── Site ──────────────────────────────────────────────────────────
# Canonical URL — used for RSS, sitemap and OG images. Astro exposes
# PUBLIC_* variables to both client and server; unprefixed variables
# are server/build only.
PUBLIC_SITE_URL=https://duckthedev.com

# ── Optional ──────────────────────────────────────────────────────
# dev  = also render draft/review posts (preview while writing)
# prod = only Status = published
ENV_MODE=dev

# Delay (ms) between Notion requests; the real rate limit is ~3 req/s.
# Defaults to 340 — only tune this if you keep hitting 429s.
# NOTION_THROTTLE_MS=340
